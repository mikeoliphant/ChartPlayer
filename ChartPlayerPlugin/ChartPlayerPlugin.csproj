<Project Sdk="Microsoft.NET.Sdk">
	<!--
	  The ChartPlayer plugin. Each build makes the DAW bundles in the output folder, clap/ChartPlayerPlugin and
	  vst3/ChartPlayerPlugin.vst3, once AudioPlugSharp's native adapters have been built (CMake, as the workflows do);
	  without them it builds the plugin and warns.
	-->
	<Import Project="..\Dependencies\AudioPlugSharp\AudioPlugSharpBridge\build\InRepo.props" />

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Version>0.2.0</Version>
		<PublishReadyToRun>false</PublishReadyToRun>
		<TieredCompilation>false</TieredCompilation>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<!-- Loaded by the AudioPlugSharp CLAP/VST3 adapters: needs a .deps.json listing every dependency -->
		<EnableDynamicLoading>true</EnableDynamicLoading>
		<!-- As in ChartPlayerJack: NVorbis 0.9.1 although MonoGame DesktopGL asks for 0.10.4 -->
		<NoWarn>$(NoWarn);NU1605</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.6.1" />
		<PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.6.1" />
		<PackageReference Include="NVorbis" Version="0.9.1" />
		<PackageReference Include="RubberBandSharp" Version="0.0.6" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Dependencies\AudioPlugSharp\AudioPlugSharpUILayout\AudioPlugSharpUILayout.csproj" />
		<ProjectReference Include="..\Dependencies\AudioPlugSharp\AudioPlugSharp\AudioPlugSharp.csproj" />
		<ProjectReference Include="..\Dependencies\AudioPlugSharp\Dependencies\UILayout\UILayout.MonoGame.Embedded\UILayout.MonoGame.Embedded.csproj" />
		<ProjectReference Include="..\Dependencies\PitchDetect\PitchDetect\PitchDetect.csproj" />
		<!-- AudioPlugSharp (crossplatform branch) and its UILayout editor glue. The adapter's bridge provides the one shared
		     AudioPlugSharp.dll at run time. -->
	</ItemGroup>
	<Target Name="RestoreDotnetTools" BeforeTargets="Restore">
		<Message Text="Restoring dotnet tools" Importance="High" />
		<Exec Command="dotnet tool restore" />
	</Target>
	<Import Project="..\ChartPlayerShared\ChartPlayerShared.projitems" Label="Shared" />
	<Import Project="..\Dependencies\OpenSongChart\SongFormat\SongFormat.projitems" Label="Shared" />
	<Import Project="..\Dependencies\AudioPlugSharp\AudioPlugSharpBridge\build\InRepo.targets" />
</Project>
