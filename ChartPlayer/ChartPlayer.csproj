<Project Sdk="Microsoft.NET.Sdk">
	<!--
	  ChartPlayer as an application: AudioPlugSharp's standalone host running the plugin built into it
	  (StandaloneHost.ForPlugin). The plugin loads in a context of its own, through this application's .deps.json.
	-->
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ApplicationIcon>Icon.ico</ApplicationIcon>
		<!-- Every method compiled once, fully optimized: tiering can cause dropouts at small buffer sizes -->
		<TieredCompilation>false</TieredCompilation>
		<!-- As in ChartPlayerPlugin: NVorbis 0.9.1 although MonoGame DesktopGL asks for 0.10.4 -->
		<NoWarn>$(NoWarn);NU1605</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\Dependencies\AudioPlugSharp\AudioPlugSharpStandalone\AudioPlugSharpStandalone.csproj" />
		<ProjectReference Include="..\ChartPlayerPlugin\ChartPlayerPlugin.csproj" />
	</ItemGroup>
</Project>
